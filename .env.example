# Firebase Web App config — sao chép file này thành `.env` và điền giá trị thật.
# Lấy từ Firebase Console > Project settings > Your apps > SDK setup and configuration.
# Lưu ý: đây là cấu hình client (không phải bí mật). Bảo mật dữ liệu được đảm bảo
# bằng Firestore Security Rules (xem firestore.rules), không phải bằng các giá trị này.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
