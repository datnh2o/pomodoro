# Firebase Web App config — sao chép file này thành `.env` và điền giá trị thật.
# Lấy từ Firebase Console > Project settings > Your apps > SDK setup and configuration.
# Lưu ý: đây là cấu hình client (không phải bí mật). Bảo mật dữ liệu được đảm bảo
# bằng Firestore Security Rules (xem firestore.rules), không phải bằng các giá trị này.
#
# Tiền tố NUXT_PUBLIC_ ánh xạ vào runtimeConfig.public.firebase.* trong nuxt.config.ts.
# Nuxt tự nạp .env khi `nuxt dev` / `nuxt build`; giá trị lúc build được nhúng làm mặc định.
# Khi chạy production (node .output/... hoặc Docker) có thể ghi đè bằng biến môi trường
# cùng tên (vd. `docker run --env-file .env`).

NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
